{
  "name": "rasoi-ratna-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "images": "node scripts/sync-images.mjs",
    "predev": "node scripts/sync-images.mjs && node scripts/sitemap.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-images.mjs && node scripts/sitemap.mjs",
    "build": "vite build",
