{
  "name": "saanvi-masale-api",
  "version": "1.0.0",
  "private": true,
  "description": "Saanvi Masale e-commerce REST API (Node.js + Express + PostgreSQL/Prisma + Redis)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:cluster": "CLUSTER=true node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "admin:create": "node scripts/create-admin.js",
    "test": "node scripts/run-tests.js",
    "loadtest": "node scripts/loadtest.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "rate-limit-redis": "^4.2.0",
    "zod": "^4.6.7",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0"
  }
}
