# ─── Saanvi Masale API — environment variables ───────────────────────────
# Copy to .env and fill in. NEVER commit .env. Values marked [prod] are required in production.

NODE_ENV=development
PORT=4000
# Comma-separated list of frontend origins allowed to call the API (CORS + cookie origin check) [prod]
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the app (1 on Render/Railway/Heroku/Nginx) so client IPs are correct
TRUST_PROXY=1
# Run one worker per CPU core (node:cluster). On PaaS with auto-scaling you can leave this off.
CLUSTER=false
WEB_CONCURRENCY=0

# ─── PostgreSQL (Supabase, Neon, RDS, or local) [prod] ───────────────────
# Supabase: use the *pooler* URL (port 6543, ?pgbouncer=true) here and the direct URL below.
DATABASE_URL=postgresql://postgres:devpass@localhost:5432/saanvi?schema=public&connection_limit=10
DIRECT_URL=postgresql://postgres:devpass@localhost:5432/saanvi?schema=public

# ─── Redis (Upstash, Redis Cloud, or local) — rate limits, OTP cooldowns, cache [prod] ─
REDIS_URL=redis://localhost:6379

# ─── Secrets — generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"  [prod]
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
OTP_PEPPER=change-me-otp-pepper-at-least-32-characters-long-xx
# Access tokens are short-lived; refresh tokens rotate on every use.
ACCESS_TOKEN_TTL=15m
CUSTOMER_SESSION_DAYS=30
ADMIN_SESSION_HOURS=12

# Refresh-token cookie. Keep SameSite=strict when the API is on a sub-domain of the shop
# (shop: saanvimasale.com, API: api.saanvimasale.com). Use "none" only if they are on different sites.
COOKIE_SAMESITE=strict
COOKIE_DOMAIN=

# ─── OTP ────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=45
# Development only: also return the OTP in the API response so you can test without email/SMS.
# Ignored (always off) when NODE_ENV=production.
OTP_DEV_ECHO=true

# ─── Email OTP (any SMTP — Gmail needs an "App password", Google Account → Security → App passwords)
# EMAIL_PROVIDER=smtp | console   (console just logs the email; development only)
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Saanvi Masale <no-reply@saanvimasale.com>"

# ─── SMS OTP — SMS_PROVIDER=msg91 | twilio | console
SMS_PROVIDER=console
# MSG91 (India, DLT-registered OTP template required)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ─── Images — STORAGE_PROVIDER=cloudinary | supabase | local ─────────────
STORAGE_PROVIDER=local
MAX_UPLOAD_MB=5
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=saanvi-masale
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media
# Public base URL of this API (used for locally stored uploads)
PUBLIC_API_URL=http://localhost:4000

# ─── Logging
LOG_LEVEL=info
